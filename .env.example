# Base URL of your qBittorrent WebUI (no trailing /api). Include scheme and port.
QBITTORRENT_URL=http://localhost:8080

# Preferred auth: API key (qBittorrent >= v5.2.0 / WebAPI v2.14.1). Generate it in
# Preferences > WebUI > API Key (format: qbt_<28 chars>). Preferred over the
# username/password pair below because it is stateless.
QBITTORRENT_API_KEY=

# Fall-back auth: WebUI username/password (works on all qBittorrent versions).
# Only used when QBITTORRENT_API_KEY is unset; the server logs in lazily and
# reuses the session cookie.
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
